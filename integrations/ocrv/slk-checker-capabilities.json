{
  "schema_version": "slk.ocrv-capabilities/v1",
  "method_version": "4.4.4",
  "required": [
    "ocrv-preview",
    "raw-output-preservation",
    "slk_checker_decide",
    "slk_read_evidence",
    "original-native-invocation-binding"
  ],
  "explicit_d1": {
    "transport": "stdio-mcp",
    "tool": "slk_checker_decide",
    "tool_allowlist": [
      "slk_checker_decide",
      "slk_read_evidence"
    ],
    "report_body_is_action": false
  },
  "optional": {
    "probe-cli": {
      "purpose": "bounded symbol discovery",
      "fallback": "native file discovery"
    },
    "rtk": {
      "purpose": "compress supported high-noise shell output",
      "fallback": "native command with original log retained"
    }
  },
  "prohibited": [
    "host-verdict-classification",
    "implicit-review-retry",
    "model-switching",
    "reasoning-level-change",
    "background-daemon"
  ]
}
