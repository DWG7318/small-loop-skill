 	"strconv"
 	"time"
 )
@@ -44,10 +45,29 @@ func newRetryObserver(collector *RetryCollector) retryObserver {
 		endedAt := time.Now()
 
 		collector.RecordAttempt(meta, observeAttempt(res, err, endedAt), startedAt, endedAt)
+		// SLK: an already refused request must not wait until its deadline
+		// merely to turn the original HTTP429 into a generic timeout. Preserve
+		// the observed headers above; only the SDK's retry control sees this
+		// cloned response. No response body or private error text is inspected.
+		if err == nil && slkRetryAfterExceedsDeadline(req, res) {
+			stopped := *res
+			stopped.Header = res.Header.Clone()
+			stopped.Header.Set("x-should-retry", "false")
+			res = &stopped
+		}
 		return res, err
 	}
 }
 
+func slkRetryAfterExceedsDeadline(req *http.Request, res *http.Response) bool {
+	if os.Getenv("SLK_CHECKER_WHOLE_CELL") != "1" || res == nil || res.StatusCode != http.StatusTooManyRequests {
+		return false
+	}
+	deadline, bounded := req.Context().Deadline()
+	hint := parseRetryAfterMS(res.Header, time.Now())
+	return bounded && hint > 0 && time.Duration(hint)*time.Millisecond >= time.Until(deadline)
+}
