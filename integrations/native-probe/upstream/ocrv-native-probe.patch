+func TestSLKDecisionMCPInnerErrorIsFailure(t *testing.T) {
+	t.Setenv("SLK_CHECKER_WHOLE_CELL", "1")
+	ctx := context.Background()
+	server := sdk.NewServer(&sdk.Implementation{Name: "offline", Version: "1"}, nil)
+	server.AddTool(&sdk.Tool{Name: "slk_checker_decide", InputSchema: map[string]any{"type": "object"}},
+		func(context.Context, *sdk.CallToolRequest) (*sdk.CallToolResult, error) {
+			return &sdk.CallToolResult{IsError: true, Content: []sdk.Content{&sdk.TextContent{Text: "CHECKER_IDENTITY_INVALID"}}}, nil
