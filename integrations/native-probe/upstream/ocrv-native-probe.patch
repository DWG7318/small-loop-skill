 var ErrRequestTimeout = errors.New("LLM request timeout (configure OCR_LLM_TIMEOUT or provider timeout_sec)")
 
 func describeTimeout(ctx context.Context, err error) error {
+	// Preserve the typed provider refusal and expose its public retry hint
+	// immediately; do not turn it into a request deadline or a D1 decision.
+	var refusal *openai.Error
+	if os.Getenv("SLK_CHECKER_WHOLE_CELL") == "1" && errors.As(err, &refusal) && refusal.StatusCode == http.StatusTooManyRequests && refusal.Response != nil {
+		if hint := parseRetryAfterMS(refusal.Response.Header, time.Now()); hint > 0 {
+			return fmt.Errorf("HTTP429 Retry-After=%dms: %w", hint, err)
+		}
+	}
 	if !errors.Is(err, context.DeadlineExceeded) {
 		return err
 	}
