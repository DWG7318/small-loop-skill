+func TestSLKRunFullyReusedStillFinalizesWholeCell(t *testing.T) {
+	t.Setenv("SLK_CHECKER_WHOLE_CELL", "")
+	setTestHome(t, t.TempDir())
+	repo := initPreviewRepo(t)
+	if err := os.WriteFile(filepath.Join(repo, "fresh.go"), []byte("package fresh\n"), 0600); err != nil {
