+	"testing"
+)
+
+type slkDecisionProvider struct {
+	calls  int
+	result string
+}
+
+func (p *slkDecisionProvider) Tool() tool.Tool { return tool.Dynamic("slk_checker_decide") }
+func (p *slkDecisionProvider) Execute(context.Context, map[string]any) (string, error) {
+	p.calls++
+	return p.result, nil
+}
+
+func TestSLKDecisionOnlyFinalStageAndNoLaterTools(t *testing.T) {
+	client := &fakeClient{}
+	deps := newTestDeps(client)
+	deps.SLKWholeCell = true
+	p := &slkDecisionProvider{result: `{"status":"CHECKER_D1_RECORDED","verdict":"FAIL"}`}
+	deps.Tools.Register(p)
+	r := NewRunner(deps)
+	call := llm.ToolCall{ID: "decide", Function: llm.FunctionCall{Name: "slk_checker_decide", Arguments: `{"verdict":"FAIL"}`}}
+	if cp := r.executeToolCall(context.Background(), "group.go", call, nil, ""); cp.Completed || p.calls != 0 {
+		t.Fatal("group submitted whole-CELL D1")
+	}
+	if cp := r.executeToolCall(context.Background(), SLKWholeCellTask, llm.ToolCall{Function: llm.FunctionCall{Name: "task_done", Arguments: `{}`}}, nil, ""); !cp.Failed {
+		t.Fatal("task_done became whole-CELL D1")
+	}
+	response := taskDoneResponse()
+	response.Choices[0].Message.ToolCalls = []llm.ToolCall{call, call}
+	client.responses = []*llm.ChatResponse{response}
+	done, _, err := r.RunMainTask(context.Background(), []llm.Message{llm.NewTextMessage("user", "final")}, SLKWholeCellTask)
+	r.WaitBackground()
+	if err != nil || !done || p.calls != 1 || client.calls != 1 {
+		t.Fatalf("done=%v err=%v calls=%d llm=%d", done, err, p.calls, client.calls)
+	}
+}
+
+func TestSLKDecisionInnerErrorIsNotCompletion(t *testing.T) {
+	deps := newTestDeps(&fakeClient{})
+	deps.SLKWholeCell = true
+	p := &slkDecisionProvider{result: `{"isError":true,"status":"CHECKER_D1_RECORDED"}`}
+	deps.Tools.Register(p)
+	cp := NewRunner(deps).executeToolCall(context.Background(), SLKWholeCellTask, llm.ToolCall{Function: llm.FunctionCall{Name: "slk_checker_decide", Arguments: `{"verdict":"PASS"}`}}, nil, "")
+	if cp.Completed {
+		t.Fatal("inner MCP error became D1")
+	}
+}
