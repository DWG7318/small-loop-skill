@@ -0,0 +1,88 @@
+package llm
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	openai "github.com/openai/openai-go/v3"
+)
+
+func TestSLKRetryAfterBeyondRequestDeadlinePreservesProviderRefusal(t *testing.T) {
+	t.Setenv("SLK_CHECKER_WHOLE_CELL", "1")
+	var calls atomic.Int32
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		calls.Add(1)
+		w.Header().Set("Content-Type", "application/json")
+		w.Header().Set("Retry-After", "276446")
+		w.WriteHeader(http.StatusTooManyRequests)
+		fmt.Fprint(w, `{"error":{"message":"limited","type":"rate_limit"}}`)
+	}))
+	defer server.Close()
+	collector := NewRetryCollector()
+	client := NewOpenAIClient(ClientConfig{URL: server.URL, APIKey: "fixture", Model: "fixture", Timeout: 200 * time.Millisecond, RetryCodes: []int{429}, retryCollector: collector})
+	_, err := ping(metaCtx(testMeta()), client)
+	var refusal *openai.Error
+	if !errors.As(err, &refusal) || refusal.StatusCode != 429 || errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("expected original typed HTTP429, got %T: %v", err, err)
+	}
+	if !strings.Contains(err.Error(), "Retry-After=276446000ms") {
+		t.Fatalf("Retry-After is not visible in public failure: %v", err)
+	}
+	if refusal.Response.Header.Get("Retry-After") != "276446" || calls.Load() != 1 {
+		t.Fatalf("original Retry-After lost or retried: %v / %d", refusal.Response.Header, calls.Load())
+	}
+	observed := attemptsFor(t, collector, testMeta())
+	if len(observed) != 1 || observed[0].StatusCode != 429 || observed[0].RetryAfterMS != 276446000 {
+		t.Fatalf("original observation changed: %+v", observed)
+	}
+}
+
+func TestSLKTimeoutWithoutProviderResponseRemainsTimeout(t *testing.T) {
+	t.Setenv("SLK_CHECKER_WHOLE_CELL", "1")
+	release := make(chan struct{})
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { <-release }))
+	defer server.Close()
+	defer close(release)
+	collector := NewRetryCollector()
+	client := NewOpenAIClient(ClientConfig{URL: server.URL, APIKey: "fixture", Model: "fixture", Timeout: 50 * time.Millisecond, retryCollector: collector})
+	_, err := ping(metaCtx(testMeta()), client)
+	if !errors.Is(err, ErrRequestTimeout) {
+		t.Fatalf("expected timeout, got %v", err)
+	}
+	observed := attemptsFor(t, collector, testMeta())
+	if len(observed) != 1 || observed[0].StatusCode != 0 || observed[0].ErrorClass != ErrorClassTimeout {
+		t.Fatalf("timeout was reclassified: %+v", observed)
+	}
+}
+
+func TestSLKRetryAfterWithinDeadlineKeepsOriginalRetry(t *testing.T) {
+	t.Setenv("SLK_CHECKER_WHOLE_CELL", "1")
+	var calls atomic.Int32
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		if calls.Add(1) == 1 {
+			w.Header().Set("Retry-After-Ms", "1")
+			w.WriteHeader(http.StatusTooManyRequests)
+			fmt.Fprint(w, `{"error":{"message":"brief limit"}}`)
+			return
+		}
+		fmt.Fprint(w, openAIOKBody)
+	}))
+	defer server.Close()
+	collector := NewRetryCollector()
+	client := NewOpenAIClient(ClientConfig{URL: server.URL, APIKey: "fixture", Model: "fixture", Timeout: time.Second, retryCollector: collector})
+	if _, err := ping(metaCtx(testMeta()), client); err != nil || calls.Load() != 2 {
+		t.Fatalf("bounded retry was changed: calls=%d error=%v", calls.Load(), err)
+	}
+	report, err := collector.Freeze("fixture")
+	if err != nil || report.RecoveredRequests != 1 || report.TotalRetries != 1 {
+		t.Fatalf("recovery facts changed: %+v / %v", report, err)
+	}
+}
