+	if _, err := parent.Run(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	resume, err := session.LoadReviewResumeState(repo, parent.SessionID())
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("SLK_CHECKER_WHOLE_CELL", "1")
+	client, p := &finalSLKClient{}, &finalSLKTool{}
+	args.Resume = resume
+	args.LLMClient = client
+	args.Tools = tool.NewRegistry()
+	args.Tools.Register(p)
+	args.Background = "SLK_NATIVE_INVOCATION=offline;REQUEST_SHA256=offline\nWhole CELL unchanged seam criterion"
+	child := New(args)
+	if _, err = child.Run(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	if client.calls != 1 || p.calls != 1 || child.ResumeInfo().RerunFiles != 0 {
+		t.Fatalf("llm=%d decision=%d resume=%+v", client.calls, p.calls, child.ResumeInfo())
