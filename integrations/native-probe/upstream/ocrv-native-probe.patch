+func (a *Agent) finishSLKWholeCell(ctx context.Context, comments []model.LlmComment) error {
+	if os.Getenv("SLK_CHECKER_WHOLE_CELL") != "1" {
+		return nil
+	}
+	if _, ok := a.args.Tools.Get("slk_checker_decide"); !ok {
+		return errors.New("SLK whole-CELL decision tool unavailable")
+	}
+	// Public group findings only. Native private reasoning stays in its archive.
+	public := append([]model.LlmComment{}, comments...)
+	for i := range public {
+		public[i].Thinking = ""
+	}
+	material, err := json.Marshal(struct {
+		Manifest *session.RunManifest `json:"file_group_manifest"`
+		Comments []model.LlmComment   `json:"comments"`
+	}{a.RunManifest(), public})
+	if err != nil {
+		return err
+	}
+	messages := []llm.Message{
+		llm.NewTextMessage("system", "You are the same original SLK Checker performing the final whole-CELL judgment after all file groups settled. Group completion/reuse, finding count and exit status are not D1. Review every CELL criterion and necessary cross-file/unchanged seams using existing read tools and relevant indexed public evidence. Do not repeat file-group reviews. Use slk_checker_decide once with your actual PASS, FAIL or INCOMPLETE and a public findings/limitations message as your final action. task_done is only a group marker and cannot decide D1. The host will dispatch only after native evidence is sealed; do not claim handoff has already happened."),
+		llm.NewTextMessage("user", a.args.Background+"\nPublic settled group results:\n"+string(material)),
+	}
+	done, stop, err := a.runner.RunMainTask(ctx, messages, llmloop.SLKWholeCellTask)
+	if a.args.CommentWorkerPool != nil {
+		a.args.CommentWorkerPool.Await()
+	}
+	a.runner.WaitBackground()
+	if err != nil {
+		return err
+	}
+	if !done {
+		return fmt.Errorf("SLK whole-CELL decision incomplete: %s", stop.Reason())
+	}
+	return nil
+}
