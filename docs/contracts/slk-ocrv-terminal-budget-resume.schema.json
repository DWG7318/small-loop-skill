{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dwg7318.github.io/small-loop-skill/contracts/slk-ocrv-terminal-budget-resume.schema.json",
  "title": "SLK OCRV terminal-budget continuation request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "method_version", "recovery_invocation_id", "run_id", "go_id", "cell_id",
    "attempt", "plan_revision", "runtime_revision", "token_sequence", "worker_role_instance_id",
    "checker_role_instance_id", "checker_endpoint_version", "checker_endpoint",
    "runtime_projection_path", "runtime_projection_sha256", "candidate_repository", "candidate_commit",
    "candidate_parent", "candidate_message_id", "payload_sha256", "candidate_submitted_event_id",
    "transport_started_event_id", "commit_request_path", "commit_request_sha256",
    "native_attempt_path", "raw_review_path", "immutable_sha256", "checker_credential_path",
    "state_command", "transport_command", "result_path", "d1_started_event_id",
    "d1_incomplete_event_id", "ocrv_preflight_path", "ocrv_preflight_sha256", "background_path",
    "background_sha256", "native_activity_path", "native_activity_sha256", "session_record_path",
    "session_record_sha256", "ocrv_session", "capacity_revision", "ocrv_transition",
    "runtime_config_binding", "owner_authorization", "role_host_binding_path",
    "role_host_binding_sha256", "recovery_root"
  ],
  "properties": {
    "schema_version": {"const": "slk.ocrv-terminal-budget-resume-request/v1"},
    "method_version": {"enum": ["4.4.0", "4.4.1", "4.4.2", "4.4.3", "4.4.4", "4.4.5"]},
    "recovery_invocation_id": {"type": "string", "format": "uuid"},
    "run_id": {"$ref": "#/$defs/identifier"},
    "go_id": {"$ref": "#/$defs/identifier"},
    "cell_id": {"$ref": "#/$defs/identifier"},
    "attempt": {"type": "integer", "minimum": 1},
    "plan_revision": {"type": "integer", "minimum": 1},
    "runtime_revision": {"type": "integer", "minimum": 1},
    "token_sequence": {"type": "integer", "minimum": 1},
    "worker_role_instance_id": {"$ref": "#/$defs/identifier"},
    "checker_role_instance_id": {"$ref": "#/$defs/identifier"},
    "checker_endpoint_version": {"type": "integer", "minimum": 1},
    "checker_endpoint": {"type": "object", "minProperties": 1},
    "runtime_projection_path": {"$ref": "#/$defs/path"},
    "runtime_projection_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_repository": {"$ref": "#/$defs/path"},
    "candidate_commit": {"$ref": "#/$defs/commit"},
    "candidate_parent": {"$ref": "#/$defs/commit"},
    "candidate_message_id": {"type": "string", "format": "uuid"},
    "payload_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_submitted_event_id": {"$ref": "#/$defs/identifier"},
    "transport_started_event_id": {"$ref": "#/$defs/identifier"},
    "commit_request_path": {"$ref": "#/$defs/path"},
    "commit_request_sha256": {"$ref": "#/$defs/sha256"},
    "native_attempt_path": {"$ref": "#/$defs/path"},
    "raw_review_path": {"$ref": "#/$defs/path"},
    "immutable_sha256": {
      "type": "object", "additionalProperties": false,
      "required": ["endpoint.json", "envelope.json", "started.json", "ocrv-request.json", "completed.json", "ocrv-result.json", "raw_review"],
      "properties": {
        "endpoint.json": {"$ref": "#/$defs/sha256"}, "envelope.json": {"$ref": "#/$defs/sha256"},
        "started.json": {"$ref": "#/$defs/sha256"}, "ocrv-request.json": {"$ref": "#/$defs/sha256"},
        "completed.json": {"$ref": "#/$defs/sha256"}, "ocrv-result.json": {"$ref": "#/$defs/sha256"},
        "raw_review": {"$ref": "#/$defs/sha256"}
      }
    },
    "checker_credential_path": {"$ref": "#/$defs/path"},
    "state_command": {"$ref": "#/$defs/command"},
    "transport_command": {"$ref": "#/$defs/command"},
    "result_path": {"$ref": "#/$defs/path"},
    "d1_started_event_id": {"$ref": "#/$defs/identifier"},
    "d1_incomplete_event_id": {"$ref": "#/$defs/identifier"},
    "ocrv_preflight_path": {"$ref": "#/$defs/path"},
    "ocrv_preflight_sha256": {"$ref": "#/$defs/sha256"},
    "background_path": {"$ref": "#/$defs/path"},
    "background_sha256": {"$ref": "#/$defs/sha256"},
    "native_activity_path": {"$ref": "#/$defs/path"},
    "native_activity_sha256": {"$ref": "#/$defs/sha256"},
    "session_record_path": {"$ref": "#/$defs/path"},
    "session_record_sha256": {"$ref": "#/$defs/sha256"},
    "ocrv_session": {"type": "object", "minProperties": 10},
    "capacity_revision": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "reason", "old", "observed", "new"],
      "properties": {
        "schema_version": {"const": "slk.ocrv-terminal-budget-capacity-revision/v1"},
        "reason": {"const": "TERMINAL_TOKEN_BUDGET_EXHAUSTED"},
        "old": {"$ref": "#/$defs/capacity"},
        "observed": {"$ref": "#/$defs/usage"},
        "new": {"$ref": "#/$defs/capacity"}
      }
    },
    "ocrv_transition": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "reason", "source_version", "target_version", "source_rule_config_sha256", "target_rule_config_sha256"],
      "properties": {
        "schema_version": {"const": "slk.ocrv-version-transition/v1"},
        "reason": {"const": "OWNER_REQUESTED_TOOL_UNIFICATION"},
        "source_version": {"$ref": "#/$defs/ocrv_version"},
        "target_version": {"$ref": "#/$defs/ocrv_version"},
        "source_rule_config_sha256": {"$ref": "#/$defs/sha256"},
        "target_rule_config_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "runtime_config_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "protocol", "model", "endpoint_host", "language", "timeout", "concurrency", "source_sha256", "target_sha256"],
      "properties": {
        "schema_version": {"const": "slk.ocrv-runtime-config-binding/v1"},
        "protocol": {"const": "openai"},
        "model": {"const": "qwen3.8-max"},
        "endpoint_host": {"type": "string", "minLength": 1},
        "language": {"type": "string", "minLength": 1},
        "timeout": {"type": "string", "minLength": 1},
        "concurrency": {"type": "integer", "minimum": 1},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "target_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "owner_authorization": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "authority", "decision", "authorization_id", "source_thread_id", "capacity_revision_sha256", "ocrv_transition_sha256", "runtime_config_binding_sha256", "occurred_at"],
      "properties": {
        "schema_version": {"const": "slk.owner-capacity-revision-authorization/v1"},
        "authority": {"const": "OWNER"}, "decision": {"const": "APPROVED"},
        "authorization_id": {"$ref": "#/$defs/identifier"},
        "source_thread_id": {"$ref": "#/$defs/identifier"},
        "capacity_revision_sha256": {"$ref": "#/$defs/sha256"},
        "ocrv_transition_sha256": {"$ref": "#/$defs/sha256"},
        "runtime_config_binding_sha256": {"$ref": "#/$defs/sha256"},
        "occurred_at": {"type": "string", "format": "date-time"}
      }
    },
    "role_host_binding_path": {"$ref": "#/$defs/path"},
    "role_host_binding_sha256": {"$ref": "#/$defs/sha256"},
    "recovery_root": {"$ref": "#/$defs/path"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "path": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ocrv_version": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "capacity": {
      "type": "object", "additionalProperties": false,
      "required": ["max_tokens", "max_tokens_budget", "timeout_minutes"],
      "properties": {
        "max_tokens": {"type": "integer", "minimum": 1},
        "max_tokens_budget": {"type": "integer", "minimum": 1},
        "timeout_minutes": {"type": "integer", "minimum": 1}
      }
    },
    "usage": {
      "type": "object", "additionalProperties": false,
      "required": ["total_tokens", "input_tokens", "output_tokens", "cache_read_tokens"],
      "properties": {
        "total_tokens": {"type": "integer", "minimum": 1},
        "input_tokens": {"type": "integer", "minimum": 1},
        "output_tokens": {"type": "integer", "minimum": 1},
        "cache_read_tokens": {"type": "integer", "minimum": 1}
      }
    }
  }
}
