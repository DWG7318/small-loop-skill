{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dwg7318.github.io/small-loop-skill/contracts/slk-ocrv-worker-recovery.schema.json",
  "title": "SLK authenticated OCRV Worker-completion recovery",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "method_version", "recovery_invocation_id", "recovery_envelope_message_id", "run_id", "go_id", "cell_id", "checker_role_instance_id", "checker_endpoint_version", "checker_endpoint", "source_attempt_root", "runtime_projection_path", "plan_revision", "runtime_revision", "token_sequence", "worker_credential_path", "checker_credential_path", "state_command", "transport_command", "occurred_at", "result_path"],
  "properties": {
    "schema_version": {"const": "slk.ocrv-worker-recovery-request/v1"},
    "method_version": {"const": "4.2.8"},
    "recovery_invocation_id": {"type": "string", "format": "uuid"},
    "recovery_envelope_message_id": {"type": "string", "format": "uuid"},
    "run_id": {"$ref": "#/$defs/identifier"},
    "go_id": {"$ref": "#/$defs/identifier"},
    "cell_id": {"$ref": "#/$defs/identifier"},
    "checker_role_instance_id": {"$ref": "#/$defs/identifier"},
    "checker_endpoint_version": {"type": "integer", "minimum": 1},
    "checker_endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "run_id", "role", "role_instance_id", "agent_runtime", "adapter", "host_id", "endpoint_version", "state", "address"],
      "properties": {
        "schema_version": {"const": "slk.transport-endpoint/v1"},
        "run_id": {"$ref": "#/$defs/identifier"},
        "role": {"const": "checker"},
        "role_instance_id": {"$ref": "#/$defs/identifier"},
        "agent_runtime": {"const": "ocrv"},
        "adapter": {"const": "ocrv-checker"},
        "host_id": {"$ref": "#/$defs/identifier"},
        "endpoint_version": {"type": "integer", "minimum": 1},
        "state": {"const": "active"},
        "address": {"type": "object", "minProperties": 1}
      }
    },
    "source_attempt_root": {"type": "string", "minLength": 1},
    "runtime_projection_path": {"type": "string", "minLength": 1},
    "plan_revision": {"type": "integer", "minimum": 1},
    "runtime_revision": {"type": "integer", "minimum": 1},
    "token_sequence": {"type": "integer", "minimum": 1},
    "worker_credential_path": {"type": "string", "minLength": 1},
    "checker_credential_path": {"type": "string", "minLength": 1},
    "state_command": {"$ref": "#/$defs/command"},
    "transport_command": {"$ref": "#/$defs/command"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "result_path": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
