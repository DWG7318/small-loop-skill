{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dwg7318.github.io/small-loop-skill/contracts/slk-checker-completion.schema.json",
  "title": "SLK authenticated Checker D1 PASS completion",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "method_version", "completion_invocation_id", "run_id", "go_id", "cell_id", "target_cell_id", "attempt", "plan_revision", "runtime_revision", "token_sequence", "checker_role_instance_id", "d1_event_id", "route", "runtime_projection_path", "target_endpoint_path", "checker_credential_path", "state_command", "transport_command", "handoff_attempt_root", "payload", "occurred_at"],
  "properties": {
    "schema_version": {"const": "slk.checker-completion-request/v1"},
    "method_version": {"enum": ["4.4.0", "4.4.1", "4.4.2", "4.4.3", "4.4.4", "4.4.5"]},
    "completion_invocation_id": {"$ref": "#/$defs/identifier"},
    "run_id": {"$ref": "#/$defs/identifier"},
    "go_id": {"$ref": "#/$defs/identifier"},
    "cell_id": {"$ref": "#/$defs/identifier"},
    "target_cell_id": {"$ref": "#/$defs/identifier"},
    "attempt": {"type": "integer", "minimum": 1},
    "plan_revision": {"type": "integer", "minimum": 1},
    "runtime_revision": {"type": "integer", "minimum": 1},
    "token_sequence": {"type": "integer", "minimum": 1},
    "checker_role_instance_id": {"$ref": "#/$defs/identifier"},
    "d1_event_id": {"$ref": "#/$defs/identifier"},
    "route": {"enum": ["NEXT_CELL", "D2_READY"]},
    "runtime_projection_path": {"$ref": "#/$defs/path"},
    "target_endpoint_path": {"$ref": "#/$defs/path"},
    "checker_credential_path": {"$ref": "#/$defs/path"},
    "state_command": {"$ref": "#/$defs/command"},
    "transport_command": {"$ref": "#/$defs/command"},
    "handoff_attempt_root": {"$ref": "#/$defs/path"},
    "payload": {"oneOf": [{"$ref": "#/$defs/workerTask"}, {"$ref": "#/$defs/d2Ready"}]},
    "occurred_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "path": {"type": "string", "minLength": 1},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "strings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "workerTask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cell_id", "cell_ordinal", "required_cell_count", "task", "d1_criteria", "root_record_path"],
      "properties": {
        "cell_id": {"$ref": "#/$defs/identifier"},
        "cell_ordinal": {"type": "integer", "minimum": 1},
        "required_cell_count": {"type": "integer", "minimum": 1},
        "task": {"type": "string", "minLength": 1},
        "d1_criteria": {"$ref": "#/$defs/strings"},
        "root_record_path": {"$ref": "#/$defs/path"}
      }
    },
    "d2Ready": {
      "type": "object",
      "additionalProperties": false,
      "required": ["d1_event_id", "required_cell_ids", "accepted_cell_ids", "final_candidate_message_id", "d2_criteria", "evidence_refs"],
      "properties": {
        "d1_event_id": {"$ref": "#/$defs/identifier"},
        "required_cell_ids": {"$ref": "#/$defs/strings"},
        "accepted_cell_ids": {"$ref": "#/$defs/strings"},
        "final_candidate_message_id": {"type": "string", "minLength": 1},
        "d2_criteria": {"$ref": "#/$defs/strings"},
        "evidence_refs": {"$ref": "#/$defs/strings"}
      }
    }
  }
}
