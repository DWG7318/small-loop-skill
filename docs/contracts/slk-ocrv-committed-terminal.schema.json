{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dwg7318.github.io/small-loop-skill/contracts/slk-ocrv-committed-terminal.schema.json",
  "title": "SLK committed OCRV terminal consumption request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "method_version", "recovery_invocation_id", "run_id", "go_id", "cell_id", "attempt", "plan_revision", "runtime_revision", "token_sequence", "worker_role_instance_id", "checker_role_instance_id", "checker_endpoint_version", "checker_endpoint", "runtime_projection_path", "runtime_projection_sha256", "candidate_repository", "candidate_commit", "candidate_parent", "candidate_message_id", "payload_sha256", "candidate_submitted_event_id", "transport_started_event_id", "commit_request_path", "commit_request_sha256", "native_attempt_path", "raw_review_path", "immutable_sha256", "checker_credential_path", "state_command", "transport_command", "result_path"],
  "properties": {
    "schema_version": {"const": "slk.ocrv-committed-terminal-request/v1"},
    "method_version": {"enum": ["4.4.0", "4.4.1", "4.4.2", "4.4.3", "4.4.4"]},
    "recovery_invocation_id": {"type": "string", "format": "uuid"},
    "run_id": {"$ref": "#/$defs/identifier"},
    "go_id": {"$ref": "#/$defs/identifier"},
    "cell_id": {"$ref": "#/$defs/identifier"},
    "attempt": {"type": "integer", "minimum": 1},
    "plan_revision": {"type": "integer", "minimum": 1},
    "runtime_revision": {"type": "integer", "minimum": 1},
    "token_sequence": {"type": "integer", "minimum": 1},
    "worker_role_instance_id": {"$ref": "#/$defs/identifier"},
    "checker_role_instance_id": {"$ref": "#/$defs/identifier"},
    "checker_endpoint_version": {"type": "integer", "minimum": 1},
    "checker_endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "run_id", "role", "role_instance_id", "agent_runtime", "adapter", "host_id", "endpoint_version", "state", "address"],
      "properties": {
        "schema_version": {"const": "slk.transport-endpoint/v1"},
        "run_id": {"$ref": "#/$defs/identifier"},
        "role": {"const": "checker"},
        "role_instance_id": {"$ref": "#/$defs/identifier"},
        "agent_runtime": {"const": "ocrv"},
        "adapter": {"const": "ocrv-checker"},
        "host_id": {"$ref": "#/$defs/identifier"},
        "endpoint_version": {"type": "integer", "minimum": 1},
        "state": {"const": "active"},
        "address": {"type": "object", "minProperties": 1}
      }
    },
    "runtime_projection_path": {"$ref": "#/$defs/path"},
    "runtime_projection_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_repository": {"$ref": "#/$defs/path"},
    "candidate_commit": {"$ref": "#/$defs/commit"},
    "candidate_parent": {"$ref": "#/$defs/commit"},
    "candidate_message_id": {"type": "string", "format": "uuid"},
    "payload_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_submitted_event_id": {"type": "string", "format": "uuid"},
    "transport_started_event_id": {"type": "string", "format": "uuid"},
    "commit_request_path": {"$ref": "#/$defs/path"},
    "commit_request_sha256": {"$ref": "#/$defs/sha256"},
    "native_attempt_path": {"$ref": "#/$defs/path"},
    "raw_review_path": {"$ref": "#/$defs/path"},
    "immutable_sha256": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint.json", "envelope.json", "started.json", "ocrv-request.json"],
      "properties": {
        "endpoint.json": {"$ref": "#/$defs/sha256"},
        "envelope.json": {"$ref": "#/$defs/sha256"},
        "started.json": {"$ref": "#/$defs/sha256"},
        "ocrv-request.json": {"$ref": "#/$defs/sha256"},
        "completed.json": {"$ref": "#/$defs/sha256"},
        "ocrv-result.json": {"$ref": "#/$defs/sha256"},
        "raw_review": {"$ref": "#/$defs/sha256"}
      }
    },
    "recovery_terminal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["native_attempt_path", "started_sha256", "completed_sha256", "ocrv_result_sha256", "resume_request_sha256", "raw_review_sha256"],
      "properties": {
        "native_attempt_path": {"$ref": "#/$defs/path"},
        "started_sha256": {"$ref": "#/$defs/sha256"},
        "completed_sha256": {"$ref": "#/$defs/sha256"},
        "ocrv_result_sha256": {"$ref": "#/$defs/sha256"},
        "resume_request_sha256": {"$ref": "#/$defs/sha256"},
        "raw_review_sha256": {"$ref": "#/$defs/sha256"},
        "source_request_path": {"$ref": "#/$defs/path"},
        "source_request_sha256": {"$ref": "#/$defs/sha256"},
        "capacity_request_sha256": {"$ref": "#/$defs/sha256"},
        "resume_lineage_sha256": {"$ref": "#/$defs/sha256"},
        "native_session_sha256": {"$ref": "#/$defs/sha256"},
        "d1_correction": {
          "type": "object", "additionalProperties": false,
          "required": ["correction_id", "d1_started_event_id", "d1_incomplete_event_id", "native_terminal_sha256", "native_result_sha256"],
          "properties": {
            "correction_id": {"$ref": "#/$defs/identifier"},
            "d1_started_event_id": {"$ref": "#/$defs/identifier"},
            "d1_incomplete_event_id": {"$ref": "#/$defs/identifier"},
            "native_terminal_sha256": {"$ref": "#/$defs/sha256"},
            "native_result_sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "independent_fail": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "request", "result", "raw_review", "session_record", "role_host", "scope_plan", "d1_started_event_id", "d1_incomplete_event_id", "owner_continuation", "supervisor_confirmation"],
      "properties": {
        "schema_version": {"const": "slk.ocrv-independent-fail/v1"},
        "request": {"$ref": "#/$defs/evidence"}, "result": {"$ref": "#/$defs/evidence"},
        "raw_review": {"$ref": "#/$defs/evidence"}, "session_record": {"$ref": "#/$defs/evidence"},
        "role_host": {"$ref": "#/$defs/evidence"},
        "scope_plan": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/evidence"}]},
        "d1_started_event_id": {"$ref": "#/$defs/identifier"},
        "d1_incomplete_event_id": {"$ref": "#/$defs/identifier"},
        "owner_continuation": {"$ref": "#/$defs/platformProof"},
        "supervisor_confirmation": {"$ref": "#/$defs/platformProof"}
      }
    },
    "partial_terminal": {
      "type": "object", "additionalProperties": false,
      "required": ["resume_request_path", "resume_request_sha256", "evidence_sha256"],
      "properties": {
        "resume_request_path": {"$ref": "#/$defs/path"},
        "resume_request_sha256": {"$ref": "#/$defs/sha256"},
        "evidence_sha256": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/sha256"}}
      }
    },
    "checker_credential_path": {"$ref": "#/$defs/path"},
    "state_command": {"$ref": "#/$defs/command"},
    "transport_command": {"$ref": "#/$defs/command"},
    "result_path": {"$ref": "#/$defs/path"}
  },
  "not": {"anyOf": [{"required": ["partial_terminal", "recovery_terminal"]}, {"required": ["independent_fail", "partial_terminal"]}, {"required": ["independent_fail", "recovery_terminal"]}]},
  "allOf": [{"if": {"required": ["independent_fail"]}, "then": {"properties": {"method_version": {"enum": ["4.4.2", "4.4.3", "4.4.4"]}}}}],
  "$defs": {
    "evidence": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "platformProof": {"type": "object", "additionalProperties": false,
      "required": ["path", "thread_id", "turn_id", "item_id", "text_sha256"],
      "properties": {"path": {"$ref": "#/$defs/path"}, "thread_id": {"$ref": "#/$defs/identifier"},
        "turn_id": {"$ref": "#/$defs/identifier"}, "item_id": {"$ref": "#/$defs/identifier"},
        "text_sha256": {"$ref": "#/$defs/sha256"}}},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "path": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
