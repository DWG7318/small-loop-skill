{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dwg7318.github.io/small-loop-skill/contracts/slk-d1-management-return.schema.json",
  "title": "SLK Supervisor return of an unchanged D1 candidate after INCOMPLETE management",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_d1_incomplete_event_id", "candidate_message_id", "candidate_payload", "candidate_payload_sha256", "management_action", "management_summary", "management_evidence_refs", "review_policy"],
  "properties": {
    "source_d1_incomplete_event_id": {"$ref": "#/$defs/identifier"},
    "candidate_message_id": {"type": "string", "minLength": 1},
    "candidate_payload": {"$ref": "#/$defs/candidatePayload"},
    "candidate_payload_sha256": {"$ref": "#/$defs/sha256"},
    "management_action": {"enum": ["ADJUST_CAPACITY", "ADJUST_ENVIRONMENT", "MECHANICAL_RECOVERY"]},
    "management_summary": {"type": "string", "minLength": 1},
    "management_evidence_refs": {"$ref": "#/$defs/nonEmptyStrings"},
    "review_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "aggregate_budget", "review_timeout", "tool_rounds"],
      "properties": {
        "profile": {"const": "NORMAL_D1_DEFAULT"},
        "aggregate_budget": {"const": "NATIVE_UNLIMITED"},
        "review_timeout": {"const": "NATIVE_UNLIMITED"},
        "tool_rounds": {"const": "TEMPLATE_DEFAULT"}
      }
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonEmptyStrings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "candidatePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "candidate", "cell_goal", "d1_criteria", "evidence_files"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "candidate": {"type": "object", "minProperties": 1},
        "cell_goal": {"type": "string", "minLength": 1},
        "d1_criteria": {"$ref": "#/$defs/nonEmptyStrings"},
        "evidence_files": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
