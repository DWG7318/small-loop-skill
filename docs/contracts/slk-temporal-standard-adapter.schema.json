{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dwg7318.github.io/small-loop-skill/contracts/slk-temporal-standard-adapter.schema.json",
  "title": "SLK 4.4.2 built-in Temporal adapter Run configuration",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "method_version", "run_id", "transport_command", "query_command", "state_config_path", "admission_kind", "admission_path", "attempt_root", "notification_attempt_root", "supervisor_endpoint_path", "role_host_binding", "overwatcher_activity"],
  "properties": {
    "schema_version": {"enum": ["slk.temporal-standard-adapter/v1", "slk.temporal-standard-adapter/v2"]}, "method_version": {"enum": ["4.4.2", "4.4.3"]},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
    "transport_command": {"$ref": "#/$defs/command"}, "query_command": {"$ref": "#/$defs/command"},
    "state_config_path": {"type": "string", "minLength": 1},
    "admission_kind": {"enum": ["PRODUCT", "ISOLATED_CONFORMANCE_SAMPLE"]},
    "admission_path": {"type": "string", "minLength": 1},
    "attempt_root": {"type": "string", "minLength": 1}, "notification_attempt_root": {"type": "string", "minLength": 1},
    "supervisor_endpoint_path": {"type": "string", "minLength": 1},
    "role_host_binding": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "overwatcher_activity": {"oneOf": [
      {"$ref": "#/$defs/overwatcher_v1"},
      {"$ref": "#/$defs/overwatcher_v2"}
    ]}
  },
  "allOf": [
    {"if": {"properties": {"schema_version": {"const": "slk.temporal-standard-adapter/v1"}}},
     "then": {"properties": {"overwatcher_activity": {"$ref": "#/$defs/overwatcher_v1"}}}},
    {"if": {"properties": {"schema_version": {"const": "slk.temporal-standard-adapter/v2"}}},
     "then": {"properties": {"overwatcher_activity": {"$ref": "#/$defs/overwatcher_v2"}}}}
  ],
  "$defs": {
    "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "overwatcher_v1": {"type": "object", "additionalProperties": false,
      "required": ["endpoint_ref", "role_instance_id", "started_path", "completed_path", "failed_path"],
      "properties": {
        "endpoint_ref": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"}, "role_instance_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
        "started_path": {"type": "string", "minLength": 1}, "completed_path": {"type": ["string", "null"]}, "failed_path": {"type": ["string", "null"]}
      }},
    "overwatcher_v2": {"type": "object", "additionalProperties": false,
      "required": ["endpoint_ref", "role_instance_id", "started_path", "completed_path", "failed_path", "attestation_path", "attestation_sha256"],
      "properties": {
        "endpoint_ref": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"}, "role_instance_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
        "started_path": {"type": "string", "minLength": 1}, "completed_path": {"type": ["string", "null"]}, "failed_path": {"type": ["string", "null"]},
        "attestation_path": {"type": "string", "minLength": 1}, "attestation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }}
  }
}
