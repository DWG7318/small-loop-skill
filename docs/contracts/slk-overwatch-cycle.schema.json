{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dwg7318.github.io/small-loop-skill/contracts/slk-overwatch-cycle.schema.json",
  "title": "SLK Overwatcher cycle",
  "type": "object",
  "additionalProperties": false,
  "required": ["cycle_id", "run_id", "plan_revision", "role_instance_id", "session_id", "foreground_turn_id", "binding_revision", "runtime_revision", "native_liveness", "cycle_sequence", "cadence_seconds", "go_id", "cell_id", "attempt", "token_sequence", "token_holder_role_instance_id", "latest_event_id", "latest_message_id", "checklist", "anomaly_codes", "evidence_refs", "cost_metrics", "native_active_session_evidence_ref", "started_at", "completed_at", "next_cycle_at"],
  "properties": {
    "cycle_id": {"$ref": "#/$defs/identifier"},
    "run_id": {"$ref": "#/$defs/identifier"},
    "plan_revision": {"type": "integer", "minimum": 1},
    "role_instance_id": {"$ref": "#/$defs/identifier"},
    "session_id": {"$ref": "#/$defs/identifier"},
    "foreground_turn_id": {"$ref": "#/$defs/identifier"},
    "binding_revision": {"type": "integer", "minimum": 1},
    "runtime_revision": {"type": "integer", "minimum": 1},
    "native_liveness": {"enum": ["IN_PROGRESS", "COMPLETED", "MISSING", "MISMATCHED"]},
    "cycle_sequence": {"type": "integer", "minimum": 1},
    "cadence_seconds": {"type": "integer", "minimum": 180, "maximum": 300},
    "go_id": {"$ref": "#/$defs/nullable_identifier"},
    "cell_id": {"$ref": "#/$defs/nullable_identifier"},
    "attempt": {"oneOf": [{"type": "integer", "minimum": 1}, {"type": "null"}]},
    "token_sequence": {"type": "integer", "minimum": 1},
    "token_holder_role_instance_id": {"$ref": "#/$defs/identifier"},
    "latest_event_id": {"$ref": "#/$defs/identifier"},
    "latest_message_id": {"oneOf": [{"type": "string", "format": "uuid"}, {"type": "null"}]},
    "checklist": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_position", "role_bindings", "direct_handoffs", "cell_lifecycle", "stall_and_duplicates", "bi_projection", "active_session", "terminal_closure"],
      "properties": {
        "run_position": {"$ref": "#/$defs/check_result"},
        "role_bindings": {"$ref": "#/$defs/check_result"},
        "direct_handoffs": {"$ref": "#/$defs/check_result"},
        "cell_lifecycle": {"$ref": "#/$defs/check_result"},
        "stall_and_duplicates": {"$ref": "#/$defs/check_result"},
        "bi_projection": {"$ref": "#/$defs/check_result"},
        "active_session": {"$ref": "#/$defs/check_result"},
        "terminal_closure": {"$ref": "#/$defs/check_result"}
      }
    },
    "anomaly_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["ACTIVITY_UNPROVEN", "DELIVERY_UNCONFIRMED", "COMMUNICATION_RECOVERY_REQUIRED", "LOOP_STALLED", "DUPLICATE_OPERATION", "ENDPOINT_DRIFT", "DUPLICATE_RUN_IDENTITY", "PROJECTION_MISMATCH", "RECORD_CONFLICT", "OVERWATCHER_ACTIVE_DEGRADED", "OVERWATCHER_INACTIVE", "TERMINAL_CLOSE_REQUIRED", "WORKER_COMPLETION_HANDOFF_MISSING"]}
    },
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence_ref"}},
    "cost_metrics": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["input_tokens", "output_tokens", "tool_output_bytes"],
          "properties": {
            "input_tokens": {"type": "integer", "minimum": 0},
            "output_tokens": {"type": "integer", "minimum": 0},
            "tool_output_bytes": {"type": "integer", "minimum": 0}
          }
        }
      ]
    },
    "native_active_session_evidence_ref": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "next_cycle_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "nullable_identifier": {"oneOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]},
    "check_result": {"enum": ["CLEAR", "ANOMALY", "NOT_APPLICABLE"]},
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
