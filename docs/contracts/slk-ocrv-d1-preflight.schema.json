{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dwg7318.github.io/small-loop-skill/contracts/slk-ocrv-d1-preflight.schema.json",
  "title": "SLK OCRV D1 request and executable preflight",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/preflight" }
  ],
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include_paths", "exclude_paths", "criterion_ids", "scope_sha256"],
      "properties": {
        "include_paths": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "exclude_paths": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "criterion_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "scope_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_background_characters", "max_background_bytes", "max_changed_lines", "max_segment_paths", "max_tokens", "max_tokens_budget", "timeout_minutes"],
      "properties": {
        "max_background_characters": { "type": "integer", "minimum": 1 },
        "max_background_bytes": { "type": "integer", "minimum": 1 },
        "max_changed_lines": { "type": "integer", "minimum": 1 },
        "max_segment_paths": { "type": "integer", "minimum": 1 },
        "max_tokens": { "type": "integer", "minimum": 1 },
        "max_tokens_budget": { "type": "integer", "minimum": 0 },
        "timeout_minutes": { "type": "integer", "minimum": 0 }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "run_id", "cell_id", "repository", "candidate", "cell_goal", "d1_criteria", "evidence_files", "review_scope", "capacity"],
      "properties": {
        "schema_version": { "const": "slk.ocrv-d1-request/v2" },
        "run_id": { "type": "string", "minLength": 1 },
        "cell_id": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "minLength": 1 },
        "candidate": { "type": "object", "minProperties": 1 },
        "cell_goal": { "type": "string", "minLength": 1 },
        "d1_criteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "evidence_files": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "review_scope": { "$ref": "#/$defs/scope" },
        "capacity": { "$ref": "#/$defs/capacity" }
      }
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "status", "run_id", "cell_id", "request_sha256", "background", "preview", "scope", "capabilities"],
      "properties": {
        "schema_version": { "const": "slk.ocrv-d1-preflight/v1" },
        "status": { "enum": ["READY", "INCOMPLETE"] },
        "run_id": { "type": "string", "minLength": 1 },
        "cell_id": { "type": "string", "minLength": 1 },
        "request_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "background": { "type": "object", "additionalProperties": false, "required": ["characters", "bytes", "evidence_bytes", "sha256"], "properties": { "characters": { "type": "integer", "minimum": 0 }, "bytes": { "type": "integer", "minimum": 0 }, "evidence_bytes": { "type": "integer", "minimum": 0 }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } },
        "preview": { "type": "object", "additionalProperties": false, "required": ["exit_code", "selected_paths", "inventory", "stdout_sha256", "stderr_sha256"], "properties": { "exit_code": { "type": "integer" }, "selected_paths": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }, "inventory": { "type": "array", "items": { "type": "object" } }, "stdout_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "stderr_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } },
        "scope": { "$ref": "#/$defs/scope" },
        "capabilities": { "type": "object", "additionalProperties": false, "required": ["available", "selected", "invocations"], "properties": { "available": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }, "selected": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }, "invocations": { "type": "array", "items": { "type": "object" } } } }
      }
    }
  }
}
