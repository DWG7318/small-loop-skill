{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dwg7318.github.io/small-loop-skill/contracts/slk-runtime-binding-migration.schema.json",
  "title": "SLK fail-closed same-identity runtime binding migration",
  "oneOf": [
    {"$ref": "#/$defs/preparation"},
    {"$ref": "#/$defs/request"},
    {"$ref": "#/$defs/progress"},
    {"$ref": "#/$defs/result"}
  ],
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "path": {"$ref": "#/$defs/text"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "command": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
    "preparation": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "run_id", "source_endpoint_path", "source_endpoint_sha256",
        "source_role_host_path", "source_role_host_sha256", "target_role_host_draft_path",
        "target_role_host_draft_sha256", "live_temporal_config_path",
        "source_temporal_config_sha256", "revise_plan_operation_path",
        "revise_plan_operation_sha256", "occurred_at", "output_root"
      ],
      "properties": {
        "schema_version": {"const": "slk.runtime-binding-migration-preparation/v1"},
        "run_id": {"$ref": "#/$defs/text"},
        "source_endpoint_path": {"$ref": "#/$defs/path"},
        "source_endpoint_sha256": {"$ref": "#/$defs/sha256"},
        "source_role_host_path": {"$ref": "#/$defs/path"},
        "source_role_host_sha256": {"$ref": "#/$defs/sha256"},
        "target_role_host_draft_path": {"$ref": "#/$defs/path"},
        "target_role_host_draft_sha256": {"$ref": "#/$defs/sha256"},
        "live_temporal_config_path": {"$ref": "#/$defs/path"},
        "source_temporal_config_sha256": {"$ref": "#/$defs/sha256"},
        "revise_plan_operation_path": {"$ref": "#/$defs/path"},
        "revise_plan_operation_sha256": {"$ref": "#/$defs/sha256"},
        "occurred_at": {"$ref": "#/$defs/text"},
        "output_root": {"$ref": "#/$defs/path"}
      }
    },
    "request": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "run_id", "role", "role_instance_id",
        "supervisor_role_instance_id", "expected_runtime_revision",
        "expected_source_plan_revision", "target_plan_revision", "expected_token_sequence",
        "source_endpoint_path", "source_endpoint_sha256", "target_endpoint_path",
        "target_endpoint_sha256", "source_role_host_path", "source_role_host_sha256",
        "target_role_host_path", "target_role_host_sha256", "live_temporal_config_path",
        "source_temporal_config_sha256", "target_temporal_config_path",
        "target_temporal_config_sha256", "rebind_admin_request_path",
        "rebind_admin_request_sha256", "revise_plan_admin_request_path",
        "revise_plan_admin_request_sha256", "query_command", "state_config_path",
        "result_path"
      ],
      "properties": {
        "schema_version": {"const": "slk.runtime-binding-migration/v1"},
        "run_id": {"$ref": "#/$defs/text"},
        "role": {"const": "checker"},
        "role_instance_id": {"$ref": "#/$defs/text"},
        "supervisor_role_instance_id": {"$ref": "#/$defs/text"},
        "expected_runtime_revision": {"type": "integer", "minimum": 1},
        "expected_source_plan_revision": {"type": "integer", "minimum": 1},
        "target_plan_revision": {"type": "integer", "minimum": 2},
        "expected_token_sequence": {"type": "integer", "minimum": 1},
        "source_endpoint_path": {"$ref": "#/$defs/path"},
        "source_endpoint_sha256": {"$ref": "#/$defs/sha256"},
        "target_endpoint_path": {"$ref": "#/$defs/path"},
        "target_endpoint_sha256": {"$ref": "#/$defs/sha256"},
        "source_role_host_path": {"$ref": "#/$defs/path"},
        "source_role_host_sha256": {"$ref": "#/$defs/sha256"},
        "target_role_host_path": {"$ref": "#/$defs/path"},
        "target_role_host_sha256": {"$ref": "#/$defs/sha256"},
        "live_temporal_config_path": {"$ref": "#/$defs/path"},
        "source_temporal_config_sha256": {"$ref": "#/$defs/sha256"},
        "target_temporal_config_path": {"$ref": "#/$defs/path"},
        "target_temporal_config_sha256": {"$ref": "#/$defs/sha256"},
        "rebind_admin_request_path": {"$ref": "#/$defs/path"},
        "rebind_admin_request_sha256": {"$ref": "#/$defs/sha256"},
        "revise_plan_admin_request_path": {"$ref": "#/$defs/path"},
        "revise_plan_admin_request_sha256": {"$ref": "#/$defs/sha256"},
        "query_command": {"$ref": "#/$defs/command"},
        "state_config_path": {"$ref": "#/$defs/path"},
        "result_path": {"$ref": "#/$defs/path"}
      }
    },
    "progress": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "status", "run_id", "runtime_revision", "plan_revision",
        "dispatch_allowed", "required_operation"
      ],
      "properties": {
        "schema_version": {"const": "slk.runtime-binding-migration-progress/v1"},
        "status": {"const": "RUNTIME_BINDING_REBOUND_AWAITING_PLAN_REVISION"},
        "run_id": {"$ref": "#/$defs/text"},
        "runtime_revision": {"type": "integer", "minimum": 1},
        "plan_revision": {"type": "integer", "minimum": 1},
        "dispatch_allowed": {"const": false},
        "required_operation": {
          "type": "object", "additionalProperties": false,
          "required": ["command", "request_path", "request_sha256"],
          "properties": {
            "command": {"const": "supervisor-admin"},
            "request_path": {"$ref": "#/$defs/path"},
            "request_sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "status", "run_id", "role", "role_instance_id",
        "supervisor_role_instance_id", "request_sha256", "source_endpoint_sha256",
        "target_endpoint_sha256", "source_role_host_sha256", "target_role_host_sha256",
        "source_temporal_config_sha256", "target_temporal_config_sha256",
        "source_temporal_config_backup_path", "runtime_revision", "plan_revision",
        "token_sequence"
      ],
      "properties": {
        "schema_version": {"const": "slk.runtime-binding-migration-result/v1"},
        "status": {"const": "RUNTIME_BINDING_MIGRATED"},
        "run_id": {"$ref": "#/$defs/text"},
        "role": {"const": "checker"},
        "role_instance_id": {"$ref": "#/$defs/text"},
        "supervisor_role_instance_id": {"$ref": "#/$defs/text"},
        "request_sha256": {"$ref": "#/$defs/sha256"},
        "source_endpoint_sha256": {"$ref": "#/$defs/sha256"},
        "target_endpoint_sha256": {"$ref": "#/$defs/sha256"},
        "source_role_host_sha256": {"$ref": "#/$defs/sha256"},
        "target_role_host_sha256": {"$ref": "#/$defs/sha256"},
        "source_temporal_config_sha256": {"$ref": "#/$defs/sha256"},
        "target_temporal_config_sha256": {"$ref": "#/$defs/sha256"},
        "source_temporal_config_backup_path": {"$ref": "#/$defs/path"},
        "runtime_revision": {"type": "integer", "minimum": 1},
        "plan_revision": {"type": "integer", "minimum": 1},
        "token_sequence": {"type": "integer", "minimum": 1}
      }
    }
  }
}
