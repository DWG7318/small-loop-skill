{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dwg7318.github.io/small-loop-skill/contracts/slk-desktop-overwatcher-attestation.schema.json",
  "title": "SLK trusted read-only Desktop Overwatcher attestation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "method_version", "attestation_id", "run_id", "role_instance_id", "endpoint_ref", "thread_id", "host_id", "cwd", "turn_id", "platform_input_item_id", "platform_input_sha256", "request_sha256", "plugin_sha256", "observed_at", "thread_status", "turn_status", "native_task_id", "started_sha256"],
  "properties": {
    "schema_version": {"const": "slk.desktop-overwatcher-attestation/v1"},
    "method_version": {"enum": ["4.4.2", "4.4.3", "4.4.4", "4.4.5"]},
    "attestation_id": {"type": "string", "format": "uuid"},
    "run_id": {"$ref": "#/$defs/text"},
    "role_instance_id": {"$ref": "#/$defs/text"},
    "endpoint_ref": {"$ref": "#/$defs/text"},
    "thread_id": {"$ref": "#/$defs/text"},
    "host_id": {"$ref": "#/$defs/text"},
    "cwd": {"$ref": "#/$defs/text"},
    "turn_id": {"$ref": "#/$defs/text"},
    "platform_input_item_id": {"$ref": "#/$defs/text"},
    "platform_input_sha256": {"$ref": "#/$defs/sha256"},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "plugin_sha256": {"$ref": "#/$defs/sha256"},
    "observed_at": {"type": "string", "format": "date-time"},
    "thread_status": {"const": "active"},
    "turn_status": {"enum": ["active", "inProgress"]},
    "native_task_id": {"$ref": "#/$defs/text"},
    "started_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "^\\S(?:.*\\S)?$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
