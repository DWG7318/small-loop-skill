{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dwg7318.github.io/small-loop-skill/contracts/slk-transport-task.schema.json",
  "title": "SLK immutable transport task",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "message_id", "run_id", "go_id", "cell_id", "endpoint", "envelope", "result_contract", "result_path"],
  "properties": {
    "schema_version": {"const": "slk.transport-task/v1"},
    "message_id": {"type": "string", "format": "uuid"},
    "run_id": {"$ref": "#/$defs/identifier"},
    "go_id": {"$ref": "#/$defs/identifier"},
    "cell_id": {"$ref": "#/$defs/identifier"},
    "endpoint": {"$ref": "#/$defs/worker_endpoint"},
    "envelope": {"$ref": "#/$defs/envelope"},
    "result_contract": {"$ref": "#/$defs/worker_result"},
    "result_path": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "worker_endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "run_id", "role", "role_instance_id", "agent_runtime", "adapter", "host_id", "endpoint_version", "state", "address"],
      "properties": {
        "schema_version": {"const": "slk.transport-endpoint/v1"},
        "run_id": {"$ref": "#/$defs/identifier"},
        "role": {"const": "worker"},
        "role_instance_id": {"$ref": "#/$defs/identifier"},
        "agent_runtime": {"const": "dsh"},
        "adapter": {"const": "dsh-worker"},
        "host_id": {"$ref": "#/$defs/identifier"},
        "endpoint_version": {"type": "integer", "minimum": 1},
        "state": {"const": "active"},
        "address": {
          "type": "object",
          "additionalProperties": false,
          "required": ["command", "instance_id", "session_id", "runtime_root", "cwd", "timeout_seconds"],
          "properties": {
            "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "instance_id": {"type": "string", "minLength": 1, "maxLength": 64},
            "session_id": {"type": ["string", "null"]},
            "runtime_root": {"type": "string", "minLength": 1},
            "cwd": {"type": "string", "minLength": 1},
            "timeout_seconds": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "message_id", "token_sequence", "run_id", "go_id", "cell_id", "sender_role", "sender_role_instance_id", "receiver_role", "receiver_role_instance_id", "receiver_endpoint_version", "payload_type", "payload_sha256", "payload"],
      "properties": {
        "schema_version": {"const": "slk.transport-envelope/v1"},
        "message_id": {"type": "string", "format": "uuid"},
        "token_sequence": {"type": "integer", "minimum": 1},
        "run_id": {"$ref": "#/$defs/identifier"},
        "go_id": {"$ref": "#/$defs/identifier"},
        "cell_id": {"$ref": "#/$defs/identifier"},
        "sender_role": {"enum": ["supervisor", "checker"]},
        "sender_role_instance_id": {"$ref": "#/$defs/identifier"},
        "receiver_role": {"const": "worker"},
        "receiver_role_instance_id": {"$ref": "#/$defs/identifier"},
        "receiver_endpoint_version": {"type": "integer", "minimum": 1},
        "payload_type": {"$ref": "#/$defs/identifier"},
        "payload_sha256": {"$ref": "#/$defs/sha256"},
        "payload": {"type": "object"}
      }
    },
    "worker_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "message_id", "run_id", "role_instance_id", "status", "candidate", "next_payload"],
      "properties": {
        "schema_version": {"const": "slk.worker-result/v1"},
        "message_id": {"type": "string", "format": "uuid"},
        "run_id": {"$ref": "#/$defs/identifier"},
        "role_instance_id": {"$ref": "#/$defs/identifier"},
        "status": {"const": "completed"},
        "candidate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "commit"],
          "properties": {
            "kind": {"const": "commit"},
            "commit": {"type": "string", "minLength": 1}
          }
        },
        "next_payload": {"type": "object"}
      }
    }
  }
}
