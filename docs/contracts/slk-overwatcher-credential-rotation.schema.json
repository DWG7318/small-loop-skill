{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dwg7318.github.io/small-loop-skill/contracts/slk-overwatcher-credential-rotation.schema.json",
  "title": "SLK exact-binding Overwatcher credential rotation",
  "type": "object",
  "additionalProperties": false,
  "required": ["rotation_id", "run_id", "expected_binding_revision", "expected_runtime_revision", "role_instance_id", "session_id", "foreground_turn_id", "expected_overwatcher_credential_id", "evidence", "reason", "occurred_at"],
  "properties": {
    "rotation_id": {"$ref": "#/$defs/identifier"},
    "run_id": {"$ref": "#/$defs/identifier"},
    "expected_binding_revision": {"type": "integer", "minimum": 1},
    "expected_runtime_revision": {"type": "integer", "minimum": 1},
    "role_instance_id": {"$ref": "#/$defs/identifier"},
    "session_id": {"type": "string", "minLength": 1},
    "foreground_turn_id": {"type": "string", "minLength": 1},
    "expected_overwatcher_credential_id": {"$ref": "#/$defs/identifier"},
    "evidence": {"$ref": "#/$defs/evidence_ref"},
    "reason": {"type": "string", "minLength": 1},
    "occurred_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
