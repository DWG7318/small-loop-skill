{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dwg7318.github.io/small-loop-skill/contracts/slk-role-host.schema.json",
  "title": "SLK prepared ordinary role host (not model context or a scheduler)",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "run_id", "plan_revision", "state_command", "transport_command", "roles", "cells", "d2_criteria"],
  "properties": {
    "schema_version": {"enum": ["slk.role-host/v1", "slk.role-host/v2"]},
    "run_id": {"type": "string", "minLength": 1},
    "plan_revision": {"type": "integer", "minimum": 1},
    "state_command": {"$ref": "#/$defs/strings"},
    "transport_command": {"$ref": "#/$defs/strings"},
    "d2_criteria": {"$ref": "#/$defs/strings"},
    "roles": {
      "type": "object", "additionalProperties": false, "required": ["supervisor", "checker", "worker"],
      "properties": {"supervisor": {"$ref": "#/$defs/role"}, "checker": {"$ref": "#/$defs/role"}, "worker": {"$ref": "#/$defs/role"}}
    },
    "cells": {
      "type": "array", "minItems": 1,
      "prefixItems": [{"$ref": "#/$defs/firstCell"}],
      "items": {"$ref": "#/$defs/nextCell"}
    },
    "temporal": {"$ref": "#/$defs/temporal"}
  },
  "allOf": [{"if": {"properties": {"schema_version": {"const": "slk.role-host/v1"}}},
    "then": {"not": {"required": ["temporal"]}}, "else": {"required": ["temporal"]}}],
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "strings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
    "role": {
      "type": "object", "additionalProperties": false, "required": ["endpoint_path", "endpoint_sha256", "credential_path"],
      "properties": {"endpoint_path": {"$ref": "#/$defs/text"}, "endpoint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "credential_path": {"$ref": "#/$defs/text"}}
    },
    "temporal": {
      "type": "object", "additionalProperties": false,
      "required": ["client_command", "workflow_identity_path", "workflow_identity_sha256", "attempt_root"],
      "properties": {
        "client_command": {"type": "array", "minItems": 3, "maxItems": 3,
          "prefixItems": [{"$ref": "#/$defs/text"}, {"const": "-m"}, {"const": "slk_temporal.delivery_client"}]},
        "workflow_identity_path": {"$ref": "#/$defs/text"},
        "workflow_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "attempt_root": {"$ref": "#/$defs/text"}
      }
    },
    "firstCell": {
      "type": "object", "additionalProperties": false, "required": ["go_id", "cell_id", "payload"],
      "properties": {"go_id": {"$ref": "#/$defs/text"}, "cell_id": {"$ref": "#/$defs/text"},
        "payload": {"oneOf": [{"$ref": "#/$defs/nextPayload"}, {"$ref": "#/$defs/initialPayload"}]}}
    },
    "initialPayload": {
      "type": "object", "additionalProperties": false, "required": ["cell_goal", "d1_criteria"],
      "properties": {"cell_goal": {"$ref": "#/$defs/text"}, "d1_criteria": {"$ref": "#/$defs/strings"}, "instructions": {"$ref": "#/$defs/text"}}
    },
    "nextCell": {
      "type": "object", "additionalProperties": false, "required": ["go_id", "cell_id", "payload"],
      "properties": {"go_id": {"$ref": "#/$defs/text"}, "cell_id": {"$ref": "#/$defs/text"}, "payload": {"$ref": "#/$defs/nextPayload"}}
    },
    "nextPayload": {
      "type": "object", "additionalProperties": false,
      "required": ["cell_id", "cell_ordinal", "required_cell_count", "task", "d1_criteria", "root_record_path"],
      "properties": {"cell_id": {"$ref": "#/$defs/text"}, "cell_ordinal": {"type": "integer", "minimum": 1},
        "required_cell_count": {"type": "integer", "minimum": 1}, "task": {"$ref": "#/$defs/text"},
        "d1_criteria": {"$ref": "#/$defs/strings"}, "root_record_path": {"$ref": "#/$defs/text"}}
    }
  }
}
