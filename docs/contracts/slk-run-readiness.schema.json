{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dwg7318.github.io/small-loop-skill/contracts/slk-run-readiness.schema.json",
  "title": "SLK Run readiness request and result",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/result" }
  ],
  "$defs": {
    "roleRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "expected_runtime", "actual_runtime", "expected_model", "actual_model", "adapter_command", "endpoint_path", "workspace_root", "context_capacity", "task_context_estimate", "required_skills", "required_tools"],
      "properties": {
        "role": { "enum": ["supervisor", "worker", "checker"] },
        "expected_runtime": { "type": "string", "minLength": 1 },
        "actual_runtime": { "type": "string", "minLength": 1 },
        "expected_model": { "type": "string", "minLength": 1 },
        "actual_model": { "type": "string", "minLength": 1 },
        "adapter_command": { "$ref": "#/$defs/nonemptyStrings" },
        "endpoint_path": { "type": "string", "minLength": 1 },
        "workspace_root": { "type": "string", "minLength": 1 },
        "context_capacity": { "type": "integer", "minimum": 1 },
        "task_context_estimate": { "type": "integer", "minimum": 1 },
        "required_skills": { "$ref": "#/$defs/nonemptyStrings" },
        "required_tools": { "$ref": "#/$defs/nonemptyStrings" }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "decision", "owner_evidence_ref"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "not": { "pattern": "^[Bb][Oo][Mm]$" } },
        "decision": { "enum": ["ON", "OFF", "UNCONFIRMED"] },
        "owner_evidence_ref": { "type": "string" }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "run_id", "plan_revision", "roles", "optional_features"],
      "properties": {
        "schema_version": { "const": "slk.run-readiness-request/v1" },
        "run_id": { "type": "string", "minLength": 1 },
        "plan_revision": { "type": "integer", "minimum": 1 },
        "roles": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/roleRequest" } },
        "optional_features": { "type": "array", "minItems": 5, "items": { "$ref": "#/$defs/option" } }
      }
    },
    "roleResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "status", "reason_codes", "repair"],
      "properties": {
        "role": { "enum": ["supervisor", "worker", "checker"] },
        "status": { "enum": ["READY", "REPAIR_NEEDED", "INCOMPATIBLE"] },
        "reason_codes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "repair": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "run_id", "plan_revision", "status", "reason_codes", "repairs", "roles", "optional_features", "request_sha256"],
      "properties": {
        "schema_version": { "const": "slk.run-readiness-result/v1" },
        "run_id": { "type": "string", "minLength": 1 },
        "plan_revision": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["READY", "REPAIR_NEEDED", "INCOMPATIBLE"] },
        "reason_codes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "repairs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "roles": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/roleResult" } },
        "optional_features": { "type": "array", "items": { "$ref": "#/$defs/option" } },
        "request_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "nonemptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
