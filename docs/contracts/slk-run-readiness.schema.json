{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dwg7318.github.io/small-loop-skill/contracts/slk-run-readiness.schema.json",
  "title": "SLK Run readiness request and result",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/result" },
    { "$ref": "#/$defs/communicationRehearsal" },
    { "$ref": "#/$defs/normalChainConformance" },
    { "$ref": "#/$defs/normalChainSource" },
    { "$ref": "#/$defs/admissionRequest" },
    { "$ref": "#/$defs/admissionResult" }
  ],
  "$defs": {
    "proof": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "communicationLeg": {
      "type": "object", "additionalProperties": false,
      "required": ["leg_id", "sender_role", "receiver_role", "endpoint", "envelope", "sent_receipt", "receiver_started", "commit_request", "commit_result"],
      "properties": {
        "leg_id": {"enum": ["SETUP_TO_CHECKER", "CELL_TO_WORKER", "CANDIDATE_TO_CHECKER", "D1_FAIL_TO_SUPERVISOR", "REWORK_TO_WORKER", "D2_READY_TO_SUPERVISOR", "ANOMALY_TO_SUPERVISOR"]},
        "sender_role": {"enum": ["supervisor", "checker", "worker", "overwatcher"]}, "receiver_role": {"enum": ["supervisor", "checker", "worker"]},
        "endpoint": {"$ref": "#/$defs/proof"}, "envelope": {"$ref": "#/$defs/proof"}, "sent_receipt": {"$ref": "#/$defs/proof"}, "receiver_started": {"$ref": "#/$defs/proof"},
        "commit_request": {"oneOf": [{"$ref": "#/$defs/proof"}, {"type": "null"}]}, "commit_result": {"oneOf": [{"$ref": "#/$defs/proof"}, {"type": "null"}]}
      }
    },
    "communicationRehearsal": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "method_version", "run_id", "plan_revision", "status", "host_binding", "sealed_role_receipts", "legs"],
      "properties": {
        "schema_version": {"const": "slk.communication-rehearsal/v2"}, "method_version": {"const": "4.4.1"}, "run_id": {"type": "string", "minLength": 1}, "plan_revision": {"type": "integer", "minimum": 1}, "status": {"const": "PASS"},
        "host_binding": {"$ref": "#/$defs/proof"},
        "sealed_role_receipts": {"type": "object", "additionalProperties": false, "required": ["supervisor", "checker", "worker", "overwatcher"],
          "properties": {"supervisor": {"$ref": "#/$defs/proof"}, "checker": {"$ref": "#/$defs/proof"}, "worker": {"$ref": "#/$defs/proof"}, "overwatcher": {"$ref": "#/$defs/proof"}}},
        "legs": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/communicationLeg"}}
      }
    },
    "normalChainConformance": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "method_version", "status", "source_run_id", "source_readiness_request", "source_communication_rehearsal"],
      "properties": {
        "schema_version": {"const": "slk.normal-chain-conformance/v1"}, "method_version": {"const": "4.4.1"},
        "status": {"const": "PASS"}, "source_run_id": {"type": "string", "minLength": 1},
        "source_readiness_request": {"$ref": "#/$defs/proof"},
        "source_communication_rehearsal": {"$ref": "#/$defs/proof"}
      }
    },
    "sourceStateContext": {
      "type": "object", "additionalProperties": false,
      "required": ["config_path", "config_sha256"],
      "properties": {
        "config_path": {"type": "string", "minLength": 1},
        "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "sourceRole": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "role_instance_id", "actual_runtime", "endpoint_path", "workspace_root"],
      "properties": {
        "role": {"enum": ["supervisor", "worker", "checker", "overwatcher"]},
        "role_instance_id": {"type": "string", "minLength": 1},
        "actual_runtime": {"type": "string", "minLength": 1},
        "endpoint_path": {"type": "string", "minLength": 1},
        "workspace_root": {"type": "string", "minLength": 1}
      }
    },
    "normalChainSource": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "method_version", "status", "source_run_id", "plan_revision", "source_state_context", "source_roles", "source_communication_rehearsal"],
      "properties": {
        "schema_version": {"const": "slk.normal-chain-source/v1"},
        "method_version": {"const": "4.4.1"},
        "status": {"const": "PASS"},
        "source_run_id": {"type": "string", "minLength": 1},
        "plan_revision": {"type": "integer", "minimum": 1},
        "source_state_context": {"$ref": "#/$defs/sourceStateContext"},
        "source_roles": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/sourceRole"}},
        "source_communication_rehearsal": {"$ref": "#/$defs/proof"}
      }
    },
    "roleRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "role_instance_id", "expected_runtime", "actual_runtime", "expected_model", "actual_model", "adapter_command", "endpoint_path", "workspace_root", "context_capacity", "task_context_estimate", "required_skills", "required_tools", "native_activity_capability", "tool_update_status"],
      "properties": {
        "role": { "enum": ["supervisor", "worker", "checker", "overwatcher"] },
        "role_instance_id": { "type": "string", "minLength": 1 },
        "expected_runtime": { "type": "string", "minLength": 1 },
        "actual_runtime": { "type": "string", "minLength": 1 },
        "expected_model": { "type": "string", "minLength": 1 },
        "actual_model": { "type": "string", "minLength": 1 },
        "adapter_command": { "$ref": "#/$defs/nonemptyStrings" },
        "endpoint_path": { "type": "string", "minLength": 1 },
        "workspace_root": { "type": "string", "minLength": 1 },
        "context_capacity": { "type": "integer", "minimum": 1 },
        "task_context_estimate": { "type": "integer", "minimum": 1 },
        "required_skills": { "$ref": "#/$defs/nonemptyStrings" },
        "required_tools": { "$ref": "#/$defs/nonemptyStrings" },
        "native_activity_capability": { "type": ["string", "null"] },
        "tool_update_status": { "enum": ["CURRENT", "UPDATE_REQUIRED", "UNPROVEN"] }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "decision", "owner_evidence_ref"],
      "properties": {
        "name": { "enum": ["Ponytail", "RTK", "Probe CLI"] },
        "decision": { "enum": ["ON", "OFF", "UNCONFIRMED"] },
        "owner_evidence_ref": { "type": "string" }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "run_id", "plan_revision", "roles", "optional_features", "bi_open_receipt", "temporal_readiness_receipt", "communication_rehearsal"],
      "properties": {
        "schema_version": { "const": "slk.run-readiness-request/v1" },
        "run_id": { "type": "string", "minLength": 1 },
        "plan_revision": { "type": "integer", "minimum": 1 },
        "roles": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/roleRequest" } },
        "optional_features": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/option" } },
        "bi_open_receipt": { "type": "string", "minLength": 1 },
        "temporal_readiness_receipt": { "type": "string", "minLength": 1 },
        "communication_rehearsal": { "type": "string", "minLength": 1 }
      }
    },
    "admissionRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "run_id", "plan_revision", "roles", "optional_features", "bi_open_receipt", "temporal_readiness_receipt", "normal_chain_conformance", "current_host_binding", "sealed_role_receipts"],
      "properties": {
        "schema_version": {"const": "slk.run-admission-request/v1"},
        "run_id": {"type": "string", "minLength": 1}, "plan_revision": {"type": "integer", "minimum": 1},
        "roles": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/roleRequest"}},
        "optional_features": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/option"}},
        "bi_open_receipt": {"type": "string", "minLength": 1}, "temporal_readiness_receipt": {"type": "string", "minLength": 1},
        "normal_chain_conformance": {"type": "string", "minLength": 1}, "current_host_binding": {"$ref": "#/$defs/proof"},
        "sealed_role_receipts": {"type": "object", "additionalProperties": false, "required": ["supervisor", "checker", "worker", "overwatcher"],
          "properties": {"supervisor": {"$ref": "#/$defs/proof"}, "checker": {"$ref": "#/$defs/proof"}, "worker": {"$ref": "#/$defs/proof"}, "overwatcher": {"$ref": "#/$defs/proof"}}}
      }
    },
    "roleResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "status", "reason_codes", "repair"],
      "properties": {
        "role": { "enum": ["supervisor", "worker", "checker", "overwatcher"] },
        "status": { "enum": ["READY", "REPAIR_NEEDED", "INCOMPATIBLE"] },
        "reason_codes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "repair": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "run_id", "plan_revision", "status", "reason_codes", "repairs", "roles", "optional_features", "request_sha256"],
      "properties": {
        "schema_version": { "const": "slk.run-readiness-result/v1" },
        "run_id": { "type": "string", "minLength": 1 },
        "plan_revision": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["READY", "REPAIR_NEEDED", "INCOMPATIBLE"] },
        "reason_codes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "repairs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "roles": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/roleResult" } },
        "optional_features": { "type": "array", "items": { "$ref": "#/$defs/option" } },
        "request_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "admissionResult": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "run_id", "plan_revision", "status", "reason_codes", "repairs", "roles", "optional_features", "conformance_run_id", "request_sha256"],
      "properties": {
        "schema_version": {"const": "slk.run-admission-result/v1"}, "run_id": {"type": "string", "minLength": 1},
        "plan_revision": {"type": "integer", "minimum": 1}, "status": {"enum": ["READY", "REPAIR_NEEDED", "INCOMPATIBLE"]},
        "reason_codes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "repairs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "roles": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/roleResult"}},
        "optional_features": {"type": "array", "items": {"$ref": "#/$defs/option"}},
        "conformance_run_id": {"type": ["string", "null"]}, "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "nonemptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
